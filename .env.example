# Copy to .env.local (never committed) and fill in. On Vercel, set these under
# Settings -> Environment Variables (tick Production, and Preview for test links).

# Supabase: Settings -> API (the URL and the publishable/anon key are public)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only, never NEXT_PUBLIC_: needed for Buy Now, webhooks and emails
SUPABASE_SERVICE_ROLE_KEY=

# Your site's address, e.g. https://yardsaleqr.example.com
NEXT_PUBLIC_SITE_URL=

# Stripe (Buy Now and plans)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=

# ZeptoMail (seller alerts and buyer confirmations)
ZEPTOMAIL_TOKEN=
ALERT_FROM_EMAIL=
# optional: ALERT_FROM_NAME, ZEPTOMAIL_API_URL

# optional: Snap & list AI suggestions
# ANTHROPIC_API_KEY=
